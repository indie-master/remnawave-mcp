limit_req_zone $binary_remote_addr zone=portal:10m rate=5r/s;
server {
    listen 443 ssl;
    server_name ${PORTAL_DOMAIN};
    ssl_certificate /etc/nginx/portal-certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/portal-certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 10m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        limit_req zone=portal burst=15 nodelay;
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host ${PORTAL_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 55s;
        proxy_request_buffering off;
        proxy_hide_header X-Powered-By;
    }
}
