FROM node:24-bookworm-slim
ENV NODE_ENV=production HOME=/home/node CODEX_HOME=/home/node/.codex CODEX_CA_CERTIFICATE=/etc/ssl/certs/ca-certificates.crt
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* && test -s /etc/ssl/certs/ca-certificates.crt
RUN npm install --global --ignore-scripts --no-audit --no-fund @openai/codex@0.162.1 && test "$(codex --version)" = "codex-cli 0.162.1" && npm cache clean --force
COPY apps/telegram-admin/intent.mjs apps/telegram-admin/intent-store.mjs apps/telegram-admin/panel-service.mjs apps/telegram-admin/ai-client.mjs apps/telegram-admin/codex-classifier.mjs apps/telegram-admin/ai-worker.mjs apps/telegram-admin/start-ai.mjs apps/telegram-admin/run-safety.mjs apps/telegram-admin/state-control.mjs apps/telegram-admin/healthcheck.mjs apps/telegram-admin/classifier-instructions.md apps/telegram-admin/intent.schema.json ./apps/telegram-admin/
COPY apps/telegram-admin/verify-ai-cli.mjs ./apps/telegram-admin/
COPY apps/telegram-admin/extra-reports.mjs ./apps/telegram-admin/
COPY apps/telegram-admin/ai-login.mjs apps/telegram-admin/ai-state-control.mjs ./apps/telegram-admin/
RUN mkdir /state /bridge /empty /home/node/.codex && chown node:node /state /bridge /home/node/.codex && chmod 700 /state /bridge /home/node/.codex
USER node
ENTRYPOINT ["node", "/app/apps/telegram-admin/start-ai.mjs"]
